# Copy to ngrok.env and fill in your values (ngrok.env is gitignored).
#
# 1. Sign up: https://ngrok.com/signup
# 2. Authtoken: ngrok config add-authtoken <token from dashboard>
# 3. Dev domain: https://dashboard.ngrok.com/domains (e.g. abc123.ngrok-free.dev)

NGROK_DOMAIN=your-assigned-domain.ngrok-free.dev
