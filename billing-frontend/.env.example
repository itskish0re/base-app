# Copy to `.env` in this folder (billing-frontend). Restart `pnpm dev` after changes.

# API base URL. Leave empty in dev to use the Vite proxy (/api → localhost:5000).
# Set explicitly only when calling the API directly (requires CORS).
VITE_API_BASE_URL=

# TanStack Query Devtools panel (true | false). Off in production builds.
VITE_ENABLE_QUERY_DEVTOOLS=true


# API base URL for vite config proxy
VITE_API_BASE_URL_PROXY=http://localhost:5000